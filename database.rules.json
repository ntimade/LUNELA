{
  "rules": {
    // ── Chats (Realtime Database) ─────────────────────────────────────────────
    // Format du chatId : "{patientUid}_{specialistUid}"
    "chats": {
      "$chatId": {
        // Lecture : l'utilisateur dont le UID apparaît dans le chatId
        ".read": "auth != null && ($chatId.contains(auth.uid))",

        "messages": {
          "$msgId": {
            // Écriture : l'émetteur doit être authentifié et faire partie du chat
            ".write": "auth != null && ($chatId.contains(auth.uid))",
            ".validate": "newData.hasChildren(['text', 'senderId', 'timestamp'])
                          && newData.child('senderId').val() == auth.uid
                          && newData.child('text').isString()
                          && newData.child('text').val().length <= 500
                          && newData.child('timestamp').isNumber()"
          }
        }
      }
    },

    // ── Présence (statut en ligne) ────────────────────────────────────────────
    "presence": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])
                      && newData.child('online').isBoolean()
                      && newData.child('lastSeen').isNumber()"
      }
    },

    // ── Typage (indicateur de saisie) ─────────────────────────────────────────
    "typing": {
      "$chatId": {
        "$uid": {
          ".read":  "auth != null && $chatId.contains(auth.uid)",
          ".write": "auth != null && auth.uid == $uid && $chatId.contains(auth.uid)",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    // ── Bloc par défaut : refus de tout le reste ──────────────────────────────
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
